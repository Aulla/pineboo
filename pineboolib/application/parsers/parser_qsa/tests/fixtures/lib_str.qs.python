# -*- coding: utf-8 -*-
from typing import TYPE_CHECKING, Any, Union
from pineboolib.qsa import qsa

# /** @file */


def entry_point(user, verb, model: "Any" = None, params: "Any" = None, method: "Any" = None):
    qsa.debug("Hola")
    return
    f: Any = get_api_function(verb, model, method)
    if not f:
        return False
    try:
        qsa.debug(qsa.ustr("f = ", f))
        return
        response_data: Any = f(user, params)
        return response_data

    except Exception:
        e = qsa.format_exc()
        qsa.debug(qsa.ustr("Error ", e))


def get_api_function(verb, model, method):
    f: Any = False
    for case in qsa.switch(model):
        if case("gt_tareas"):
            for case in qsa.switch(verb):
                if case("get"):
                    for case in qsa.switch(method):
                        if case(None):
                            f = "Hola"
                            break
                    break

            break

    return f
